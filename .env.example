# Optional. Short share links (/?s=<id>) store the song in a Vercel Blob store.
# Connect a Blob store to the Vercel project and this is injected for you; locally run
# `vercel env pull .env.local` to get it. Without it the Share button still works: it falls
# back to a self-contained #song= link that carries the whole song in the URL.
BLOB_READ_WRITE_TOKEN=
